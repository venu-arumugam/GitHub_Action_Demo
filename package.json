{
  "name": "github-action-demo",
  "version": "1.0.0",
  "description": "Cypress UI and API test automation framework with GitHub Actions CI/CD",
  "license": "ISC",
  "author": "Venu - QA Automation",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:ui": "cypress run --spec cypress/e2e/UI_Test/**/*.cy.js",
    "test:api": "cypress run --spec cypress/e2e/API_Test/**/*.cy.js",
    "test:all": "cypress run",
    "lint": "eslint cypress/**/*.js",
    "report:open": "start cypress/reports/html/index.html"
  },
  "devDependencies": {
    "cypress": "^15.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
